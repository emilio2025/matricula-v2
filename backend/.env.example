# Copie este archivo como .env  (en Git Bash: cp .env.example .env)
PORT=3001
FRONTEND_URL=http://localhost:5173

# Clave para firmar las sesiones (genere una con:)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Culqi > CulqiPanel > Desarrollo > API Keys (entorno de INTEGRACIÓN)
# Si las deja vacías, los pagos funcionan en MODO SIMULADO.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Opcional: llave RSA para cifrar el checkout (CulqiPanel > Desarrollo > RSA Keys)
CULQI_RSA_ID=
CULQI_RSA_PUBLIC_KEY=
# Opcional: usuario y clave que configure en el webhook de CulqiPanel
CULQI_WEBHOOK_USER=
CULQI_WEBHOOK_PASSWORD=

# ---------------- Mercado Pago (pasarela principal) ----------------
# Mercado Pago Developers > Tus integraciones > tu aplicación > Credenciales de PRUEBA
# Si se completa, los pagos se hacen con Mercado Pago (tiene prioridad sobre Culqi).
MP_ACCESS_TOKEN=
# Opcional (requiere URL pública https): avisos de pago y su clave secreta de firma
MP_NOTIFICATION_URL=
MP_WEBHOOK_SECRET=

# ---------------- Base de datos MySQL ----------------
# Datos de conexión de tu MySQL local (XAMPP, MySQL Server o Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=matricula_db
